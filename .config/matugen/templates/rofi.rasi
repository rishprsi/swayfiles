/* Auto theme -- Rofi colors (generated by matugen).
 * Pure black window, pastel accents from the wallpaper. */

* {
  bg0: #000000e6;
  bg1: {{colors.surface_container.default.hex}};
  fg0: {{colors.on_surface.default.hex}};
  fg1: {{colors.outline.default.hex}};

  red: {{colors.error.default.hex}};
  red-trans: {{colors.error.default.hex}}2e;
  green: {{colors.primary.default.hex}};
  green-trans: {{colors.primary.default.hex}}2e;
  yellow: {{colors.tertiary.default.hex}};
  yellow-trans: {{colors.tertiary.default.hex}}2e;
  blue: {{colors.primary.default.hex}};
  blue-trans: {{colors.primary.default.hex}}2e;
  purple: {{colors.primary.default.hex}};
  purple-trans: {{colors.primary.default.hex}}2e;
  aqua: {{colors.secondary.default.hex}};
  aqua-trans: {{colors.secondary.default.hex}}2e;
}
